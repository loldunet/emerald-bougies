# ===========================
# Configuration SMTP (Emails)
# ===========================
SMTP_HOST=smtp.mail.ovh.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@emerald-bougies.re
SMTP_PASS=votre_mot_de_passe_smtp
SMTP_FROM=contact@emerald-bougies.re
CONTACT_TO=contact@emerald-bougies.re

# ===========================
# Configuration Paybox (Verifone)
# ===========================
# Mode test (préprod) ou production
# Mettre 'production' pour utiliser l'environnement réel
NODE_ENV=development

# Identifiants Paybox (fournis par Verifone)
PAYBOX_SITE=1999888              # Numéro de site (test: 1999888)
PAYBOX_RANG=32                   # Numéro de rang
PAYBOX_IDENTIFIANT=107904482     # Identifiant du contrat
PAYBOX_CLE=VOTRE_CLE_HMAC_64_CHARS_HEX  # Clé HMAC secrète (64 caractères hexadécimaux)

# URL frontend pour les retours de paiement
FRONTEND_URL=https://emerald-bougies.re

# Clé admin pour l'API
ADMIN_KEY=emerald2024
